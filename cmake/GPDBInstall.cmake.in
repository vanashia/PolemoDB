# Generated by the GPDB top-level CMake project.  It deliberately delegates to
# the configured legacy install because that is the authoritative install graph
# for the server, all contrib modules, procedural languages, and support files.
set(_gpdb_install_env "@GPDB_CONFIGURE_ENV@")
set(_gpdb_install_command "@CMAKE_COMMAND@" -E env)
list(APPEND _gpdb_install_command ${_gpdb_install_env})
list(APPEND _gpdb_install_command "@GPDB_MAKE_PROGRAM@" -C
     "@GPDB_LEGACY_BUILD_DIR@" install "prefix=${CMAKE_INSTALL_PREFIX}")

execute_process(
  COMMAND ${_gpdb_install_command}
  RESULT_VARIABLE _gpdb_install_result)
if(NOT _gpdb_install_result EQUAL 0)
  message(FATAL_ERROR "GPDB legacy install failed (${_gpdb_install_result})")
endif()
