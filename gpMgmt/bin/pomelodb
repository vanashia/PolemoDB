#!/usr/bin/env python3
"""Manage a local PomeloDB instance from the installed pomelodb.conf."""

import os
import subprocess
import sys


CONFIG_NAME = "pomelodb.conf"
MANAGED_BEGIN = "# BEGIN POMELODB MANAGED LOGGING"
MANAGED_END = "# END POMELODB MANAGED LOGGING"
ALLOWED_KEYS = {
    "cluster_mode", "coordinator_data_directory", "segment_data_directories",
    "log_directory", "stop_mode", "wait",
}


class ConfigError(Exception):
    pass


def installation_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def resolve_path(value, root):
    if not os.path.isabs(value):
        value = os.path.join(root, value)
    return os.path.abspath(os.path.expanduser(value))


def parse_config(root):
    config_path = os.path.join(root, CONFIG_NAME)
    values = {}
    try:
        with open(config_path, encoding="utf-8") as config_file:
            for line_number, raw_line in enumerate(config_file, 1):
                line = raw_line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    raise ConfigError("%s:%d: expected key=value" %
                                      (config_path, line_number))
                key, value = line.split("=", 1)
                key, value = key.strip(), value.strip()
                if key not in ALLOWED_KEYS:
                    raise ConfigError("%s:%d: unsupported setting %s" %
                                      (config_path, line_number, key))
                if key in values:
                    raise ConfigError("%s:%d: duplicate setting %s" %
                                      (config_path, line_number, key))
                values[key] = value
    except OSError as error:
        raise ConfigError("cannot read %s: %s" % (config_path, error))

    if values.get("cluster_mode", "mpp") != "mpp":
        raise ConfigError("only cluster_mode=mpp is supported")
    for key in ("coordinator_data_directory", "segment_data_directories",
                "log_directory"):
        if not values.get(key):
            raise ConfigError("%s must be set in %s" % (key, config_path))
    values["coordinator_data_directory"] = resolve_path(
        values["coordinator_data_directory"], root)
    values["segment_data_directories"] = [
        resolve_path(path.strip(), root)
        for path in values["segment_data_directories"].split(",")
        if path.strip()
    ]
    if not values["segment_data_directories"]:
        raise ConfigError("segment_data_directories must not be empty")
    values["log_directory"] = resolve_path(values["log_directory"], root)
    for data_path in [values["coordinator_data_directory"]] + values[
            "segment_data_directories"]:
        common_path = os.path.commonpath([data_path, values["log_directory"]])
        if common_path in (data_path, values["log_directory"]):
            raise ConfigError("data directories and log_directory must be separate")

    values.setdefault("stop_mode", "fast")
    if values["stop_mode"] not in ("smart", "fast", "immediate"):
        raise ConfigError("stop_mode must be smart, fast, or immediate")
    values.setdefault("wait", "true")
    if values["wait"].lower() not in ("true", "false"):
        raise ConfigError("wait must be true or false")
    values["wait"] = values["wait"].lower() == "true"
    return values


def command_path(root, name):
    return os.path.join(root, "bin", name)


def run(command):
    try:
        return subprocess.call(command)
    except OSError as error:
        sys.stderr.write("pomelodb: cannot run %s: %s\n" % (command[0], error))
        return 1


def configure_cluster_logging(values):
    for data_directory in [values["coordinator_data_directory"]] + values[
            "segment_data_directories"]:
        configure_logging_for_directory(data_directory, values["log_directory"])


def configure_logging_for_directory(data_directory, log_directory):
    config_path = os.path.join(data_directory, "postgresql.conf")
    if not os.path.isfile(config_path):
        raise ConfigError("%s does not exist; initialize the cluster first" % config_path)
    with open(config_path, encoding="utf-8") as config_file:
        lines = config_file.readlines()
    retained = []
    in_managed_block = False
    for line in lines:
        if line.rstrip("\n") == MANAGED_BEGIN:
            in_managed_block = True
            continue
        if line.rstrip("\n") == MANAGED_END:
            in_managed_block = False
            continue
        if not in_managed_block:
            retained.append(line)
    if retained and not retained[-1].endswith("\n"):
        retained[-1] += "\n"
    escaped_log_directory = log_directory.replace("'", "''")
    retained.extend([
        "\n", MANAGED_BEGIN + "\n", "logging_collector = on\n",
        "log_directory = '%s'\n" % escaped_log_directory,
        "log_filename = 'pomelodb-%Y-%m-%d_%H%M%S.log'\n",
        MANAGED_END + "\n",
    ])
    with open(config_path, "w", encoding="utf-8") as config_file:
        config_file.writelines(retained)


def init(root, values):
    configure_cluster_logging(values)
    return 0


def start(root, values):
    os.makedirs(values["log_directory"], mode=0o750, exist_ok=True)
    configure_cluster_logging(values)
    commands = []
    for data_directory in values["segment_data_directories"]:
        commands.append([command_path(root, "pg_ctl"), "start", "-D",
                         data_directory, "-l",
                         os.path.join(values["log_directory"], "segment-startup.log"),
                         "-o", "-c gp_role=execute"])
    commands.append([command_path(root, "pg_ctl"), "start", "-D",
                     values["coordinator_data_directory"], "-l",
                     os.path.join(values["log_directory"], "coordinator-startup.log"),
                     "-o", "-c gp_role=dispatch"])
    return run_all(commands, values["wait"])


def stop(root, values):
    commands = [[command_path(root, "pg_ctl"), "stop", "-D",
                 values["coordinator_data_directory"], "-m", values["stop_mode"]]]
    commands.extend([
        [command_path(root, "pg_ctl"), "stop", "-D", data_directory,
         "-m", values["stop_mode"]]
        for data_directory in values["segment_data_directories"]
    ])
    return run_all(commands, values["wait"])


def reload(root, values):
    configure_cluster_logging(values)
    commands = [[command_path(root, "pg_ctl"), "reload", "-D",
                 values["coordinator_data_directory"]]]
    commands.extend([
        [command_path(root, "pg_ctl"), "reload", "-D", data_directory]
        for data_directory in values["segment_data_directories"]
    ])
    return run_all(commands, False)


def status(root, values):
    commands = [[command_path(root, "pg_ctl"), "status", "-D",
                 values["coordinator_data_directory"]]]
    commands.extend([
        [command_path(root, "pg_ctl"), "status", "-D", data_directory]
        for data_directory in values["segment_data_directories"]
    ])
    return run_all(commands, False)


def run_all(commands, wait):
    result = 0
    for command in commands:
        if wait:
            command.append("-w")
        result = run(command)
        if result != 0:
            break
    return result


def usage():
    sys.stderr.write("usage: pomelodb {init|start|stop|reload|status}\n")


def main(argv):
    if len(argv) != 2 or argv[1] not in ("init", "start", "stop", "reload", "status"):
        usage()
        return 2
    try:
        root = installation_root()
        values = parse_config(root)
        return {
            "init": init, "start": start, "stop": stop,
            "reload": reload, "status": status,
        }[argv[1]](root, values)
    except ConfigError as error:
        sys.stderr.write("pomelodb: %s\n" % error)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
